  "version": 1,
  "project_state_cases": [
    {
      "name": "root_safety_denied_workspace_root",
      "operation": "validate_root",
      "root_ref": "workspace_root",
      "require_workspace": true,
      "expect": "fail",
      "error": "RootValidationError"
    },
    {
      "name": "root_safety_symlink_escape_rejected",
      "operation": "load_symlink_escape",
      "expect": "fail",
      "error": "RootValidationError"
    },
    {
      "name": "default_state_valid_without_repo_write",
      "operation": "default_state_validate",
      "expect": "pass",
      "expected": {
        "status": "uninitialized",
        "revision": 0
      }
    },
    {
      "name": "migration_classifies_invalid_legacy_value_as_conflict",
      "operation": "legacy_env_classification",
      "values": {
        "CONTEXTFORGE_SERENA_DECISION": "maybe"
      },
      "expect": "pass",
      "expected": {
        "disposition": "conflict",
        "digest_present": true,
        "conflict_reason": "malformed_or_conflicting_legacy_env",
        "open_item_severity": "blocking"
      }
    },
    {
      "name": "sticky_decline_imports_from_legacy_env",
      "operation": "apply_legacy_env_migration_validate",
      "values": {
        "CONTEXTFORGE_SERENA_DECISION": "declined"
      },
      "expect": "pass",
      "expected": {
        "disposition": "imported",
        "decision_state": "declined",
        "decision_notes_contains": "sticky_decline",
        "status": "disabled",
        "migration_seen": true,
        "imported_at_present": true
      }
    },
    {
      "name": "disabled_no_service_imports_without_initialized_status",
      "operation": "apply_legacy_env_migration_validate",
      "values": {
        "CONTEXTFORGE_SERENA_DECISION": "disabled"
      },
      "expect": "pass",
      "expected": {
        "disposition": "imported",
        "decision_state": "disabled",
        "status": "disabled",
        "migration_seen": true,
        "imported_at_present": true
      }
    },
    {
      "name": "secret_exclusion_rejects_secret_like_state_field",
      "operation": "validate_state",
      "mutations": [
        {
          "op": "set",
          "path": ["x_api_token"],
          "value": "plain-placeholder"
        }
      ],
      "expect": "fail",
      "error": "StateValidationError"
    },
    {
      "name": "invalid_enum_rejects_project_status",
      "operation": "validate_state",
      "mutations": [
        {
          "op": "set",
          "path": ["status"],
          "value": "done"
        }
      ],
      "expect": "fail",
      "error": "StateValidationError"
    },
    {
      "name": "schema_evolution_rejects_unsupported_major",
      "operation": "validate_state",
      "mutations": [
        {
          "op": "set",
          "path": ["meta", "schema_version"],
          "value": 2
        }
      ],
      "expect": "fail",
      "error": "StateValidationError"
    },
    {
      "name": "stale_lock_recovers_on_temp_project",
      "operation": "write_state_with_stale_lock",
      "lock_age_seconds": 120,
      "stale_after_seconds": 1,
      "expect": "pass",
      "expected": {
        "revision": 1
      }
    }
  ],
