# Copy to env/contextforge.env with scripts/init-env.sh.
# Do not commit env/contextforge.env.

APP_NAME=ContextForge Container Harness
HOST=0.0.0.0
PORT=4444
DATABASE_URL=sqlite:////data/mcp.db

MCPGATEWAY_UI_ENABLED=true
MCPGATEWAY_ADMIN_API_ENABLED=true
AUTH_REQUIRED=true
API_ALLOW_BASIC_AUTH=false
DOCS_ALLOW_BASIC_AUTH=false
SECURE_COOKIES=false

PLATFORM_ADMIN_EMAIL=admin@contextforge-harness.dev
PLATFORM_ADMIN_PASSWORD=replace-with-generated-secret
PLATFORM_ADMIN_FULL_NAME=ContextForge Harness Admin

BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=replace-with-generated-secret
JWT_SECRET_KEY=replace-with-generated-secret-at-least-32-chars
AUTH_ENCRYPTION_SECRET=replace-with-generated-secret-at-least-32-chars
CSRF_SECRET_KEY=replace-with-generated-secret-at-least-32-chars

TOKEN_EXPIRY=20
TOKEN_IDLE_TIMEOUT=60
ADMIN_REQUIRE_PASSWORD_CHANGE_ON_BOOTSTRAP=false
LOG_LEVEL=INFO
