{
  "providers": {
    "litellm": {
      "baseUrl": "$LITELLM_BASE_URL",
      "api": "openai-responses",
      "apiKey": "$LITELLM_API_KEY",
      "authHeader": true,
      "compat": {
        "supportsDeveloperRole": true,
        "supportsReasoningEffort": true
      },
      "models": [
        {
          "id": "codex/gpt-5.6-terra",
          "name": "GPT-5.6 Terra (human)",
          "reasoning": true,
          "thinkingLevelMap": {
            "minimal": "minimal",
            "low": "low",
            "medium": "medium",
            "high": "high",
            "xhigh": "xhigh",
            "max": null
          },
          "input": ["text", "image"],
          "contextWindow": 1050000,
          "maxTokens": 128000
        },
        {
          "id": "codex/gpt-5.6-luna",
          "name": "GPT-5.6 Luna (blind/default)",
          "reasoning": true,
          "thinkingLevelMap": {
            "minimal": "minimal",
            "low": "low",
            "medium": "medium",
            "high": "high",
            "xhigh": "xhigh",
            "max": null
          },
          "input": ["text", "image"],
          "contextWindow": 1050000,
          "maxTokens": 128000
        },
        {
          "id": "codex/gpt-5.6-sol",
          "name": "GPT-5.6 Sol (evaluator)",
          "reasoning": true,
          "thinkingLevelMap": {
            "minimal": "minimal",
            "low": "low",
            "medium": "medium",
            "high": "high",
            "xhigh": "xhigh",
            "max": null
          },
          "input": ["text", "image"],
          "contextWindow": 350000,
          "maxTokens": 128000
        }
      ]
    }
  }
}
