{
  "providers": {
    "openrouter-semantic-test": {
      "baseUrl": "$OPENROUTER_BASE_URL",
      "api": "openai-completions",
      "apiKey": "$OPENROUTER_API_KEY",
      "authHeader": true,
      "headers": {
        "x-session-id": "$OPENROUTER_STICKY_KEY"
      },
      "compat": {
        "supportsDeveloperRole": true,
        "supportsReasoningEffort": false
      },
      "models": [
        {
          "id": "google/gemma-4-26b-a4b-it",
          "name": "Configured semantic-test model via OpenRouter",
          "reasoning": false,
          "input": ["text", "image"],
          "contextWindow": 262144,
          "maxTokens": 65535,
          "cost": {
            "input": 0.1,
            "output": 0.4,
            "cacheRead": 0.01,
            "cacheWrite": 0.08333333333333334
          }
        }
      ]
    }
  }
}
