{
  "$schema": "https://opencode.ai/config.json",
  "model": "llama.cpp/{env:LOCAL_LLAMA_MODEL}",
  "provider": {
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (host local)",
      "options": {
        "baseURL": "{env:LOCAL_LLAMA_BASE_URL}",
        "apiKey": "{env:LOCAL_LLAMA_KEY}"
      },
      "models": {
        "qwen3.6-a3b": {
          "name": "Qwen 3.6 A3B via host llama.cpp",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        }
      }
    }
  }
}
