# Optional live target for ssh-tmux semantic tests.
#
# Copy this file to `.env` in the same directory and replace the dummy values.
# The `.env` file is ignored by Git.

CONTEXTFORGE_SSH_TMUX_TEST_HOST=example.invalid
CONTEXTFORGE_SSH_TMUX_TEST_PORT=22
CONTEXTFORGE_SSH_TMUX_TEST_USERNAME=agent

# Supported values for test prompts/runners: key, password, agent
CONTEXTFORGE_SSH_TMUX_TEST_AUTH_MODE=key

# Use exactly one of these for key/password auth. Leave both empty for agent auth.
CONTEXTFORGE_SSH_TMUX_TEST_PRIVATE_KEY_PATH=/run/contextforge-ssh-tmux/id_ed25519
CONTEXTFORGE_SSH_TMUX_TEST_PASSWORD=

# Optional SSH behavior and harmless read-only probe.
CONTEXTFORGE_SSH_TMUX_TEST_KNOWN_HOSTS_PATH=/run/contextforge-ssh-tmux/known_hosts
CONTEXTFORGE_SSH_TMUX_TEST_STRICT_HOST_KEY_CHECKING=yes
CONTEXTFORGE_SSH_TMUX_TEST_REMOTE_PROBE_COMMAND=printf 'contextforge-ssh-tmux-ok\n'
CONTEXTFORGE_SSH_TMUX_TEST_REMOTE_WORKDIR=
